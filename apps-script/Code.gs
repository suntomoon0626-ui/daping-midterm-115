function doGet(e) {
  if(e&&e.parameter&&e.parameter.mode==='api'){try{return jsonResponse_({ok:true,state:getState()});}catch(error){return jsonResponse_({ok:false,error:error.message});}}
  return HtmlService.createHtmlOutputFromFile('Index').setTitle('大坪實小｜期中評量填報').addMetaTag('viewport','width=device-width, initial-scale=1');
}

// 初始化僅在不存在資料時建立固定課表，不會重設現有資料。
function initialize(){return initialize_();}

// 內部儲存函式不對瀏覽器開放。
function initialize_() {
  return locked_(function(){
    var props=PropertiesService.getScriptProperties();
    if(props.getProperty('ACTIVE_SNAPSHOT'))return '資料已存在，未重設。';
    writeState_({slots:SEED.slots,exams:{},logs:[],version:0,verified:false});
    return '已建立共用資料。授課資料尚待教務核對。';
  });
}

function getState() {
  return locked_(function(){return readState_();});
}

function saveExam(input) {
  return locked_(function(){
    var state=readState_(),slot=slot_(state,input && input.id);
    if(!state.verified)throw Error('授課資料尚未核對，暫不開放正式填寫。');
    if(slot.locked||slot.pending)throw Error('固定活動或尚待核對的時段禁止填寫。');
    if(!input||!slot.teachers.includes(input.teacher))throw Error('僅限此時段原授課老師填寫。');
    revision_(slot,input.rev);
    var subject=bounded_(input.subject,40,'評量科目'),range=bounded_(input.range,500,'評量範圍');
    state.exams[slot.id]={subject:subject,range:range,teacher:input.teacher,updatedAt:new Date().toISOString()};
    slot.rev++;state.version++;writeState_(state);return state;
  });
}

function withdrawExam(input) {
  return locked_(function(){
    var state=readState_(),slot=slot_(state,input && input.id);
    if(slot.locked||slot.pending||!input||!slot.teachers.includes(input.teacher))throw Error('無權修改此時段。');
    revision_(slot,input.rev);
    delete state.exams[slot.id];slot.rev++;state.version++;writeState_(state);return state;
  });
}

function swapLessons(input) {
  return locked_(function(){
    admin_(input&&input.password);
    var state=readState_(),a=slot_(state,input.from),b=slot_(state,input.to);
    if(a.id===b.id||a.g!==b.g)throw Error('請選擇同一年級兩個不同時段。');
    if(a.locked||b.locked||a.pending||b.pending)throw Error('固定活動及待核對時段禁止調整。');
    if(state.exams[a.id]||state.exams[b.id])throw Error('請先撤回兩格已填評量再調課。');
    revision_(a,input.fromRev);revision_(b,input.toRev);
    var reason=bounded_(input.reason,200,'調課原因');
    var entry=SEED.days[a.d]+' 第'+(a.p+1)+'節 '+a.subject+' ↔ '+SEED.days[b.d]+' 第'+(b.p+1)+'節 '+b.subject+'（'+(a.g+1)+'年級）。'+reason;
    var subject=a.subject,teachers=a.teachers;a.subject=b.subject;a.teachers=b.teachers;b.subject=subject;b.teachers=teachers;
    a.rev++;b.rev++;state.version++;state.logs.push({text:entry,at:new Date().toISOString()});state.logs=state.logs.slice(-50);
    writeState_(state);return state;
  });
}

function correctLesson(input) {
  return locked_(function(){
    admin_(input&&input.password);
    var state=readState_(),s=slot_(state,input.id);revision_(s,input.rev);
    if(state.exams[s.id])throw Error('請先撤回已填評量。');
    var subject=bounded_(input.subject,40,'原課程'),reason=bounded_(input.reason,200,'核對說明');
    if(typeof input.locked!=='boolean'||typeof input.pending!=='boolean')throw Error('狀態不正確。');
    if(!Array.isArray(input.teachers)||input.teachers.length>6||input.teachers.some(function(t){return !SEED.names.includes(t);}))throw Error('授課老師不正確。');
    if(!input.locked&&!input.pending&&!input.teachers.length)throw Error('開放時段須指定授課老師。');
    // 已確定的固定活動不能由這個更正功能開放。主題課等待核對格可核對後開放。
    if(s.locked&&!s.pending&&!input.locked)throw Error('已確定的固定活動不能解除鎖定。');
    s.subject=subject;s.teachers=Array.from(new Set(input.teachers));s.locked=input.locked;s.pending=input.pending;s.rev++;state.version++;
    state.logs.push({text:'課表核對：'+(s.g+1)+'年級 '+SEED.days[s.d]+' 第'+(s.p+1)+'節。'+reason,at:new Date().toISOString()});state.logs=state.logs.slice(-50);
    writeState_(state);return state;
  });
}

function confirmTimetable(input) {
  return locked_(function(){
    admin_(input&&input.password);var state=readState_();
    if(state.slots.some(function(s){return s.pending;}))throw Error('還有待核對時段，請先逐格確認。');
    if(input.version!==state.version)throw Error('課表已更新，請重新整理後再確認。');
    state.verified=true;state.version++;writeState_(state);return state;
  });
}

function locked_(callback) {
  var lock=LockService.getScriptLock();
  if(!lock.tryLock(10000))throw Error('其他老師正在儲存，請稍後再試。');
  try{return callback();}finally{lock.releaseLock();}
}
function slot_(state,id){var s=state.slots.find(function(x){return x.id===id;});if(!s)throw Error('找不到時段。');return s;}
function revision_(slot,rev){if(!Number.isInteger(rev)||slot.rev!==rev)throw Error('此時段已被更新。請重新整理，確認最新內容後再填寫。');}
function bounded_(value,max,label){if(typeof value!=='string'||!value.trim()||value.trim().length>max)throw Error(label+'必填，最多 '+max+' 字。');return value.trim();}
function admin_(password){
  var props=PropertiesService.getScriptProperties(),stored=props.getProperty('ADMIN_PASSWORD');
  if(!stored)throw Error('尚未設定教務管理碼，請由擁有者於專案設定新增 ADMIN_PASSWORD。');
  if(typeof password!=='string'||password.length>200)throw Error('管理碼錯誤。');
  var hash=function(s){return Utilities.base64Encode(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,s,Utilities.Charset.UTF_8));};
  var a=hash(password),b=hash(stored),difference=0;for(var i=0;i<a.length;i++)difference|=a.charCodeAt(i)^b.charCodeAt(i);
  if(difference!==0)throw Error('管理碼錯誤。');
}

// 寫入完整新快照後才切換指標，避免調課只寫入一半。舊快照於提交後清除。
function writeState_(state){
  var props=PropertiesService.getScriptProperties();
  var encoded=Utilities.base64Encode(Utilities.gzip(Utilities.newBlob(JSON.stringify(state),'application/json')).getBytes());
  if(encoded.length>160000)throw Error('共用儲存空間不足，請先匯出備份並聯絡教務。');
  var old=props.getProperty('ACTIVE_SNAPSHOT'),version=Utilities.getUuid(),entries={},n=Math.ceil(encoded.length/8000);
  // 清除上次中途失敗留下、並非目前有效版本的暫存塊。
  var active=old?JSON.parse(old).version:null;
  Object.keys(props.getProperties()).forEach(function(k){if(k.indexOf('DATA:')===0&&k.split(':')[1]!==active)props.deleteProperty(k);});
  for(var i=0;i<n;i++)entries['DATA:'+version+':'+i]=encoded.slice(i*8000,(i+1)*8000);
  props.setProperties(entries);
  props.setProperty('ACTIVE_SNAPSHOT',JSON.stringify({version:version,count:n}));
  if(old){var previous=JSON.parse(old);for(var j=0;j<previous.count;j++){try{props.deleteProperty('DATA:'+previous.version+':'+j);}catch(ignore){}}}
}
function readState_(){
  var props=PropertiesService.getScriptProperties(),pointer=props.getProperty('ACTIVE_SNAPSHOT');
  if(!pointer)throw Error('共用儲存尚未初始化，請擁有者在編輯器執行 initialize。');
  var meta=JSON.parse(pointer),encoded='';for(var i=0;i<meta.count;i++){var part=props.getProperty('DATA:'+meta.version+':'+i);if(part===null)throw Error('資料不完整，請聯絡教務。');encoded+=part;}
  return JSON.parse(Utilities.ungzip(Utilities.newBlob(Utilities.base64Decode(encoded),'application/gzip')).getDataAsString('UTF-8'));
}

// GitHub 上的單頁全校表直接讀寫既有共用儲存。
function doPost(e){
  try{
    if(!e||!e.postData||e.postData.contents.length>8000)throw Error('請求格式不正確。');
    var body=JSON.parse(e.postData.contents),input=body.input,result;
    switch(body.action){
      case 'saveExam':result=saveExam(input);break;
      case 'withdrawExam':result=withdrawExam(input);break;
      case 'swapLessons':result=swapLessons(input);break;
      case 'correctLesson':result=correctLesson(input);break;
      case 'confirmTimetable':result=confirmTimetable(input);break;
      default:throw Error('未知操作。');
    }
    return jsonResponse_({ok:true,state:result});
  }catch(error){return jsonResponse_({ok:false,error:error.message});}
}
function jsonResponse_(value){return ContentService.createTextOutput(JSON.stringify(value)).setMimeType(ContentService.MimeType.JSON);}

